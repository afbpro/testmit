Options -MultiViews
RewriteEngine On
RewriteBase /

# Pretty API routes mapped to PHP entrypoint.
RewriteRule ^api/(.*)$ api/index.php/$1 [QSA,L]

# Keep existing files and directories accessible.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback for React Router routes.
RewriteRule ^ index.html [L]
